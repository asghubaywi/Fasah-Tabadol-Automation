# Fasah-Tabadol-Automation — Environment Variables
# ===================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Never commit .env to version control.

# ── Agent configuration ────────────────────────────────────────────────────
# Override the config file location
# AGENT_CONFIG=config/agent_fasah.yaml

# Override the compliance rules file
# FASAH_RULES=config/fasah_rules.yaml

# ── Fasah portal ───────────────────────────────────────────────────────────
# Base URL for the Fasah portal
FASAH_BASE_URL=https://fasah.gov.sa

# Portal credentials (loaded from env, NEVER stored in config files)
# FASAH_USERNAME=your_username
# FASAH_PASSWORD=your_password
# FASAH_OTP_SECRET=your_totp_secret

# ── Browser worker ─────────────────────────────────────────────────────────
# Worker environment: dev = relaxed security, prod = strict enforcement
ZC_ENV=dev

# Inbox/Outbox for the browser worker
# (browser_tasks → worker → browser_results)
ZC_INBOX=workspace/outbox/browser_tasks
ZC_OUTBOX=workspace/outbox/browser_results
ZC_STATE=workspace/state

# Domain allowlist (comma-separated, wildcards supported)
# REQUIRED in prod mode: AGENT_BROWSER_ALLOWED_DOMAINS=*.fasah.gov.sa,fasah.gov.sa

# Optional: override in prod
# AGENT_BROWSER_ENCRYPTION_KEY=<base64-encoded-key>
# AGENT_BROWSER_SESSION_NAME=fasah_prod

# Poll interval for the browser worker (seconds)
ZC_POLL_INTERVAL=3

# Playwright timeouts (ms)
# ZC_PW_NAV_TIMEOUT=60000
# ZC_PW_ACTION_TIMEOUT=30000
# ZC_ANGULAR_SETTLE_MS=8000

# ── Rust engine ────────────────────────────────────────────────────────────
# Path to the compiled fasah-engine binary
# Defaults to target/release/fasah-engine (or target/debug/ fallback)
# FASAH_ENGINE_BIN=target/release/fasah-engine

# ── Logging ────────────────────────────────────────────────────────────────
RUST_LOG=info
LOG_LEVEL=INFO
